# ============================================
# Bling MCP Pro - Configuração
# ============================================
# Copie este arquivo para .env e preencha com seus valores.
# NUNCA commite o arquivo .env no Git!

# ----- OBRIGATÓRIO -----

# Access token do Bling (gerado no painel do Bling > Integrações > API)
BLING_TOKEN=

# ----- OPCIONAL: Renovação automática de token (OAuth2) -----
# Se preencher os 3 campos abaixo, o servidor renova o token automaticamente
# quando expira. Caso contrário, você terá que atualizar BLING_TOKEN manualmente.

BLING_CLIENT_ID=
BLING_CLIENT_SECRET=
BLING_REFRESH_TOKEN=

# ----- OPCIONAL: Servidor -----

# Transporte do MCP: stdio (Claude Desktop) ou sse (HTTP remoto)
# Padrão: stdio
MCP_TRANSPORT=stdio

# Porta para modo HTTP/SSE (ignorado em stdio)
# Padrão: 4545
MCP_PORT=4545

# Endpoint SSE (ignorado em stdio)
# Padrão: /sse
MCP_ENDPOINT=/sse

# ----- OPCIONAL: Logs -----

# Nível de log: debug, info, warn, error, silent
# - debug: TUDO (atenção: pode mostrar dados sensíveis)
# - info: operações normais (padrão para produção)
# - warn: apenas avisos e erros
# - error: apenas erros
# - silent: nada
LOG_LEVEL=info

# ----- OPCIONAL: Rate Limiting -----

# Limite de requisições por segundo à API do Bling
# Padrão: 3 (conservador, abaixo do limite real do Bling)
RATE_LIMIT_PER_SECOND=3

# ----- OPCIONAL: URL da API -----
# Só altere se souber o que está fazendo
BLING_API_URL=https://www.bling.com.br/Api/v3
